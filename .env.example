# Copia este archivo como .env y completa los valores reales de esta computadora.
# El archivo .env NUNCA debe subirse a git.

# Identificador de esta PC (sirve para saber quien capturo cada dato)
PC_ID=PC-01

# Conexion a MySQL (solo se usa al sincronizar cuando haya internet)
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASS=
MYSQL_NAME=

# Usuario y contraseña para entrar al sistema en esta PC
# AUTH_PASS_HASH es un hash (no la contraseña en texto plano).
# Para generarlo: php generar_hash_password.php "tu_contraseña"
AUTH_USER=admin
AUTH_PASS_HASH=
